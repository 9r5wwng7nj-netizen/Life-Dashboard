{
  "schemaVersion": "0.1.0",
  "name": "Library video",
  "behavior": "create",
  "noteNameFormat": "{{title|safe_name}}",
  "path": "Library/Podcasts and Videos",
  "properties": [
    {
      "name": "type",
      "value": "video",
      "type": "text"
    },
    {
      "name": "status",
      "value": "saved",
      "type": "text"
    },
    {
      "name": "created",
      "value": "{{date|date:\"YYYY-MM-DD\"}}",
      "type": "date"
    },
    {
      "name": "date_saved",
      "value": "{{date|date:\"YYYY-MM-DD\"}}",
      "type": "date"
    },
    {
      "name": "author",
      "value": "{{author}}",
      "type": "text"
    },
    {
      "name": "source_url",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "transcript_status",
      "value": "requested",
      "type": "text"
    },
    {
      "name": "related_projects",
      "value": "",
      "type": "multitext"
    }
  ],
  "triggers": [
    "https://www.youtube.com/watch",
    "https://youtu.be/",
    "https://vimeo.com/"
  ],
  "noteContentFormat": "> [!info] Saved from [{{site}}]({{url}}) on {{date|date:\"MMMM D, YYYY\"}}\n\n## Source details\n\n{{description}}\n\n## Transcript\n\n## Summary\n\n## Key quotations\n\n## My reflections\n\n## Connections and applications\n"
}
